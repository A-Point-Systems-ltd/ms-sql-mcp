{
  "name": "ms-sql-mcp",
  "displayName": "APoint-ms-sql",
  "description": "SQL Server MCP server for VS Code, Cursor and Claude - multi-connection, object explorer with DDL, read-only profiles, AI schema insights.",
  "publisher": "apoint",
  "version": "1.2.5",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/A-Point-Systems-ltd/ms-sql-mcp"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:mssql-sql"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "apoint.ms-sql-mcp",
        "label": "APoint-ms-sql"
      }
    ],
    "languages": [
      {
        "id": "sql",
        "filenamePatterns": [
          "**/~sql/**"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "msSqlMcp",
          "title": "APoint-ms-sql",
          "icon": "media/db.svg"
        }
      ],
      "panel": [
        {
          "id": "msSqlMcpResults",
          "title": "APoint-ms-sql Results",
          "icon": "media/db.svg"
        }
      ]
    },
    "views": {
      "msSqlMcp": [
        {
          "id": "msSqlMcp.explorer",
          "name": "Connections"
        }
      ],
      "msSqlMcpResults": [
        {
          "id": "msSqlMcp.results",
          "name": "Results",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "msSqlMcp.explorer",
        "contents": "No connections yet.\n[Add Connection](command:msSqlMcp.addConnection)"
      }
    ],
    "commands": [
      {
        "command": "msSqlMcp.addConnection",
        "title": "Add Connection",
        "category": "APoint-ms-sql",
        "icon": "$(add)"
      },
      {
        "command": "msSqlMcp.editConnection",
        "title": "Edit Connection",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.removeConnection",
        "title": "Remove Connection",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.testConnection",
        "title": "Test Connection",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.openConnection",
        "title": "Open (expose to MCP)",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.closeConnection",
        "title": "Close (hide from MCP)",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.dataView",
        "title": "Show Data",
        "category": "APoint-ms-sql",
        "icon": "$(table)"
      },
      {
        "command": "msSqlMcp.dataViewReplace",
        "title": "Show Data - Replace Current Tab",
        "category": "APoint-ms-sql",
        "icon": "$(table)"
      },
      {
        "command": "msSqlMcp.showDdl",
        "title": "Show DDL",
        "category": "APoint-ms-sql",
        "icon": "$(file-code)"
      },
      {
        "command": "msSqlMcp.showDdlNewTab",
        "title": "Show DDL - New Tab",
        "category": "APoint-ms-sql",
        "icon": "$(file-code)"
      },
      {
        "command": "msSqlMcp.showHistory",
        "title": "Show DDL History",
        "category": "APoint-ms-sql",
        "icon": "$(history)"
      },
      {
        "command": "msSqlMcp.registerClients",
        "title": "Register with Cursor / Claude...",
        "category": "APoint-ms-sql",
        "icon": "$(plug)"
      },
      {
        "command": "msSqlMcp.showLogs",
        "title": "Show Logs",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.refresh",
        "title": "Refresh",
        "category": "APoint-ms-sql",
        "icon": "$(refresh)"
      },
      {
        "command": "msSqlMcp.filter",
        "title": "Filter Group by Name…",
        "category": "APoint-ms-sql",
        "icon": "$(filter)"
      },
      {
        "command": "msSqlMcp.clearFilter",
        "title": "Clear Group Filter",
        "category": "APoint-ms-sql",
        "icon": "$(filter-filled)"
      },
      {
        "command": "msSqlMcp.newQuery",
        "title": "New Query",
        "category": "APoint-ms-sql",
        "icon": "$(new-file)"
      },
      {
        "command": "msSqlMcp.openSqlFile",
        "title": "Open SQL File…",
        "category": "APoint-ms-sql",
        "icon": "$(folder-opened)"
      },
      {
        "command": "msSqlMcp.openRecentQuery",
        "title": "Open Recent Query…",
        "category": "APoint-ms-sql",
        "icon": "$(history)"
      },
      {
        "command": "msSqlMcp.changeConnection",
        "title": "Change Connection",
        "category": "APoint-ms-sql",
        "icon": "$(database)"
      },
      {
        "command": "msSqlMcp.connectEditor",
        "title": "Connect Editor to…",
        "category": "APoint-ms-sql",
        "icon": "$(plug)"
      },
      {
        "command": "msSqlMcp.runQuery",
        "title": "Run (F5)",
        "category": "APoint-ms-sql",
        "icon": "$(play)"
      },
      {
        "command": "msSqlMcp.cancelQuery",
        "title": "Cancel Query",
        "category": "APoint-ms-sql",
        "icon": "$(debug-stop)"
      },
      {
        "command": "msSqlMcp.runQueryReadOnly",
        "title": "Run (F5) - disabled: read-only connection. Apply changes on a read-write connection.",
        "category": "APoint-ms-sql",
        "icon": "$(play)",
        "enablement": "false"
      },
      {
        "command": "msSqlMcp.refreshIntelliSense",
        "title": "Refresh IntelliSense Cache",
        "category": "APoint-ms-sql",
        "icon": "$(refresh)"
      },
      {
        "command": "msSqlMcp.formatSql",
        "title": "Format SQL (selection or document)",
        "category": "APoint-ms-sql",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "msSqlMcp.goToObjectDefinition",
        "title": "Go to Object Definition (new tab)",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.selectTopRows",
        "title": "Select Top Rows of Object Under Cursor",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.pickColumns",
        "title": "Pick Columns…",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.expandWildcard",
        "title": "Expand * to Column List",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.disableEnhancedCompletions",
        "title": "✓ Enhanced Completions (click to turn off)",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.enableEnhancedCompletions",
        "title": "Enhanced Completions (off, click to turn on)",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.newQueryWithText",
        "title": "New Query With Text",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.copyName",
        "title": "Copy Name",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.renameObject",
        "title": "Rename… (F2)",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.clearAllFilters",
        "title": "Clear All Filters",
        "category": "APoint-ms-sql",
        "icon": "$(clear-all)"
      },
      {
        "command": "msSqlMcp.editorOptions",
        "title": "SQL Editor Options…",
        "category": "APoint-ms-sql",
        "icon": "$(settings-gear)"
      },
      {
        "command": "msSqlMcp.queryShortcut0",
        "title": "Run Query Shortcut Ctrl+0",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.queryShortcut1",
        "title": "Run Query Shortcut Ctrl+1",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.queryShortcut2",
        "title": "Run Query Shortcut Ctrl+2",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.queryShortcut3",
        "title": "Run Query Shortcut Ctrl+3",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.queryShortcut4",
        "title": "Run Query Shortcut Ctrl+4",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.queryShortcut5",
        "title": "Run Query Shortcut Ctrl+5",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.queryShortcut6",
        "title": "Run Query Shortcut Ctrl+6",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.queryShortcut7",
        "title": "Run Query Shortcut Ctrl+7",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.queryShortcut8",
        "title": "Run Query Shortcut Ctrl+8",
        "category": "APoint-ms-sql"
      },
      {
        "command": "msSqlMcp.queryShortcut9",
        "title": "Run Query Shortcut Ctrl+9",
        "category": "APoint-ms-sql"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "msSqlMcp.clearAllFilters",
          "when": "view == msSqlMcp.explorer && msSqlMcp.filterActive",
          "group": "navigation@0"
        },
        {
          "command": "msSqlMcp.addConnection",
          "when": "view == msSqlMcp.explorer",
          "group": "navigation@1"
        },
        {
          "command": "msSqlMcp.registerClients",
          "when": "view == msSqlMcp.explorer",
          "group": "navigation@2"
        },
        {
          "command": "msSqlMcp.refresh",
          "when": "view == msSqlMcp.explorer",
          "group": "navigation@3"
        },
        {
          "command": "msSqlMcp.openRecentQuery",
          "when": "view == msSqlMcp.explorer",
          "group": "navigation@4"
        },
        {
          "command": "msSqlMcp.editorOptions",
          "when": "view == msSqlMcp.explorer",
          "group": "9_options@1"
        }
      ],
      "view/item/context": [
        {
          "command": "msSqlMcp.newQuery",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.conn\\./",
          "group": "inline@0"
        },
        {
          "command": "msSqlMcp.openSqlFile",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.conn\\./",
          "group": "inline@1"
        },
        {
          "command": "msSqlMcp.newQuery",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.conn\\./",
          "group": "0@1"
        },
        {
          "command": "msSqlMcp.openSqlFile",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.conn\\./",
          "group": "0@2"
        },
        {
          "command": "msSqlMcp.dataView",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.obj\\.(table|view)(\\.history)?$/",
          "group": "inline@1"
        },
        {
          "command": "msSqlMcp.showDdl",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.obj\\./",
          "group": "inline@2"
        },
        {
          "command": "msSqlMcp.dataView",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.obj\\.(table|view)(\\.history)?$/",
          "group": "0@1"
        },
        {
          "command": "msSqlMcp.dataViewReplace",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.obj\\.(table|view)(\\.history)?$/",
          "group": "0@2"
        },
        {
          "command": "msSqlMcp.showDdl",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.obj\\./",
          "group": "0@3"
        },
        {
          "command": "msSqlMcp.showDdlNewTab",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.obj\\./",
          "group": "0@4"
        },
        {
          "command": "msSqlMcp.showHistory",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.obj\\..*\\.history$/",
          "group": "0@5"
        },
        {
          "command": "msSqlMcp.refresh",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.category/",
          "group": "inline@3"
        },
        {
          "command": "msSqlMcp.refresh",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.conn\\./",
          "group": "1@0"
        },
        {
          "command": "msSqlMcp.testConnection",
          "when": "viewItem =~ /^msSqlMcp\\.conn/",
          "group": "1@1"
        },
        {
          "command": "msSqlMcp.openConnection",
          "when": "viewItem == msSqlMcp.conn.closed",
          "group": "1@2"
        },
        {
          "command": "msSqlMcp.closeConnection",
          "when": "viewItem == msSqlMcp.conn.open",
          "group": "1@2"
        },
        {
          "command": "msSqlMcp.editConnection",
          "when": "viewItem =~ /^msSqlMcp\\.conn/",
          "group": "2@1"
        },
        {
          "command": "msSqlMcp.removeConnection",
          "when": "viewItem =~ /^msSqlMcp\\.conn/",
          "group": "2@2"
        },
        {
          "command": "msSqlMcp.copyName",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.obj\\./",
          "group": "9_cutcopypaste@1"
        },
        {
          "command": "msSqlMcp.renameObject",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.obj\\./",
          "group": "9_cutcopypaste@2"
        },
        {
          "command": "msSqlMcp.filter",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.category\\.list/",
          "group": "inline@1"
        },
        {
          "command": "msSqlMcp.clearFilter",
          "when": "view == msSqlMcp.explorer && viewItem == msSqlMcp.category.list.filtered",
          "group": "inline@2"
        },
        {
          "command": "msSqlMcp.filter",
          "when": "view == msSqlMcp.explorer && viewItem =~ /^msSqlMcp\\.category\\.list/",
          "group": "2_filter@1"
        },
        {
          "command": "msSqlMcp.clearFilter",
          "when": "view == msSqlMcp.explorer && viewItem == msSqlMcp.category.list.filtered",
          "group": "2_filter@2"
        }
      ],
      "commandPalette": [
        {
          "command": "msSqlMcp.dataView",
          "when": "false"
        },
        {
          "command": "msSqlMcp.showDdl",
          "when": "false"
        },
        {
          "command": "msSqlMcp.dataViewReplace",
          "when": "false"
        },
        {
          "command": "msSqlMcp.showDdlNewTab",
          "when": "false"
        },
        {
          "command": "msSqlMcp.showHistory",
          "when": "resource in msSqlMcp.historyDocs"
        },
        {
          "command": "msSqlMcp.changeConnection",
          "when": "editorLangId == sql || msSqlMcp.editorConnected"
        },
        {
          "command": "msSqlMcp.connectEditor",
          "when": "false"
        },
        {
          "command": "msSqlMcp.runQuery",
          "when": "msSqlMcp.editorConnected || editorLangId == sql"
        },
        {
          "command": "msSqlMcp.cancelQuery",
          "when": "msSqlMcp.queryRunning"
        },
        {
          "command": "msSqlMcp.runQueryReadOnly",
          "when": "false"
        },
        {
          "command": "msSqlMcp.refreshIntelliSense",
          "when": "msSqlMcp.editorConnected"
        },
        {
          "command": "msSqlMcp.newQueryWithText",
          "when": "false"
        },
        {
          "command": "msSqlMcp.formatSql",
          "when": "editorLangId == sql"
        },
        {
          "command": "msSqlMcp.goToObjectDefinition",
          "when": "editorLangId == sql && msSqlMcp.editorConnected"
        },
        {
          "command": "msSqlMcp.selectTopRows",
          "when": "editorLangId == sql && msSqlMcp.editorConnected"
        },
        {
          "command": "msSqlMcp.pickColumns",
          "when": "editorLangId == sql && msSqlMcp.editorConnected"
        },
        {
          "command": "msSqlMcp.expandWildcard",
          "when": "editorLangId == sql && msSqlMcp.editorConnected"
        },
        {
          "command": "msSqlMcp.disableEnhancedCompletions",
          "when": "msSqlMcp.enhancedCompletions"
        },
        {
          "command": "msSqlMcp.enableEnhancedCompletions",
          "when": "!msSqlMcp.enhancedCompletions"
        },
        {
          "command": "msSqlMcp.copyName",
          "when": "false"
        },
        {
          "command": "msSqlMcp.renameObject",
          "when": "false"
        },
        {
          "command": "msSqlMcp.clearFilter",
          "when": "false"
        },
        {
          "command": "msSqlMcp.clearAllFilters",
          "when": "msSqlMcp.filterActive"
        },
        {
          "command": "msSqlMcp.queryShortcut0",
          "when": "editorLangId == sql && msSqlMcp.shortcut.0"
        },
        {
          "command": "msSqlMcp.queryShortcut1",
          "when": "editorLangId == sql && msSqlMcp.shortcut.1"
        },
        {
          "command": "msSqlMcp.queryShortcut2",
          "when": "editorLangId == sql && msSqlMcp.shortcut.2"
        },
        {
          "command": "msSqlMcp.queryShortcut3",
          "when": "editorLangId == sql && msSqlMcp.shortcut.3"
        },
        {
          "command": "msSqlMcp.queryShortcut4",
          "when": "editorLangId == sql && msSqlMcp.shortcut.4"
        },
        {
          "command": "msSqlMcp.queryShortcut5",
          "when": "editorLangId == sql && msSqlMcp.shortcut.5"
        },
        {
          "command": "msSqlMcp.queryShortcut6",
          "when": "editorLangId == sql && msSqlMcp.shortcut.6"
        },
        {
          "command": "msSqlMcp.queryShortcut7",
          "when": "editorLangId == sql && msSqlMcp.shortcut.7"
        },
        {
          "command": "msSqlMcp.queryShortcut8",
          "when": "editorLangId == sql && msSqlMcp.shortcut.8"
        },
        {
          "command": "msSqlMcp.queryShortcut9",
          "when": "editorLangId == sql && msSqlMcp.shortcut.9"
        }
      ],
      "editor/title": [
        {
          "command": "msSqlMcp.changeConnection",
          "when": "editorLangId == sql && resourceScheme != mssql-ddl && msSqlMcp.editorBound",
          "group": "navigation@0"
        },
        {
          "command": "msSqlMcp.connectEditor",
          "when": "editorLangId == sql && resourceScheme != mssql-ddl && !msSqlMcp.editorBound",
          "group": "navigation@0"
        },
        {
          "command": "msSqlMcp.refresh",
          "when": "resourceScheme == mssql-ddl",
          "group": "navigation"
        },
        {
          "command": "msSqlMcp.runQuery",
          "when": "resource in msSqlMcp.runnableDocs",
          "group": "navigation@1"
        },
        {
          "command": "msSqlMcp.runQuery",
          "when": "editorLangId == sql && resourceScheme != mssql-ddl && !msSqlMcp.editorConnected",
          "group": "navigation@1"
        },
        {
          "command": "msSqlMcp.runQueryReadOnly",
          "when": "resource in msSqlMcp.blockedDocs",
          "group": "navigation@1"
        },
        {
          "command": "msSqlMcp.cancelQuery",
          "when": "resource in msSqlMcp.runningDocs",
          "group": "navigation@2"
        },
        {
          "command": "msSqlMcp.showHistory",
          "when": "resource in msSqlMcp.historyDocs",
          "group": "navigation@3"
        },
        {
          "command": "msSqlMcp.refreshIntelliSense",
          "when": "msSqlMcp.editorConnected && resource in msSqlMcp.intellisenseDocs",
          "group": "navigation@4"
        },
        {
          "command": "msSqlMcp.disableEnhancedCompletions",
          "when": "editorLangId == sql && msSqlMcp.enhancedCompletions",
          "group": "1_msSqlMcp@1"
        },
        {
          "command": "msSqlMcp.enableEnhancedCompletions",
          "when": "editorLangId == sql && !msSqlMcp.enhancedCompletions",
          "group": "1_msSqlMcp@1"
        },
        {
          "command": "msSqlMcp.editorOptions",
          "when": "editorLangId == sql",
          "group": "1_msSqlMcp@2"
        }
      ],
      "editor/context": [
        {
          "command": "msSqlMcp.changeConnection",
          "when": "editorLangId == sql && resourceScheme != mssql-ddl && msSqlMcp.editorBound",
          "group": "msSqlMcp@0"
        },
        {
          "command": "msSqlMcp.connectEditor",
          "when": "editorLangId == sql && resourceScheme != mssql-ddl && !msSqlMcp.editorBound",
          "group": "msSqlMcp@0"
        },
        {
          "command": "msSqlMcp.refreshIntelliSense",
          "when": "msSqlMcp.editorConnected",
          "group": "msSqlMcp@1"
        },
        {
          "command": "msSqlMcp.formatSql",
          "when": "editorLangId == sql && resourceScheme != mssql-ddl",
          "group": "1_modification@9"
        },
        {
          "command": "msSqlMcp.goToObjectDefinition",
          "when": "editorLangId == sql && msSqlMcp.editorConnected",
          "group": "navigation@9"
        },
        {
          "command": "msSqlMcp.selectTopRows",
          "when": "editorLangId == sql && msSqlMcp.editorConnected",
          "group": "msSqlMcp@2"
        },
        {
          "command": "msSqlMcp.pickColumns",
          "when": "editorLangId == sql && msSqlMcp.editorConnected && msSqlMcp.enhancedCompletions",
          "group": "msSqlMcp@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "msSqlMcp.changeConnection",
          "when": "editorLangId == sql && resourceScheme != mssql-ddl && msSqlMcp.editorBound",
          "group": "1_msSqlMcp@0"
        },
        {
          "command": "msSqlMcp.connectEditor",
          "when": "editorLangId == sql && resourceScheme != mssql-ddl && !msSqlMcp.editorBound",
          "group": "1_msSqlMcp@0"
        },
        {
          "command": "msSqlMcp.disableEnhancedCompletions",
          "when": "editorLangId == sql && msSqlMcp.enhancedCompletions",
          "group": "1_msSqlMcp@1"
        },
        {
          "command": "msSqlMcp.enableEnhancedCompletions",
          "when": "editorLangId == sql && !msSqlMcp.enhancedCompletions",
          "group": "1_msSqlMcp@1"
        },
        {
          "command": "msSqlMcp.editorOptions",
          "when": "editorLangId == sql",
          "group": "1_msSqlMcp@2"
        }
      ]
    },
    "configuration": {
      "title": "APoint-ms-sql",
      "properties": {
        "msSqlMcp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Override path to MssqlMcp.exe (default: bundled)."
        },
        "msSqlMcp.insights": {
          "type": "boolean",
          "default": true,
          "description": "Enable the AI Insights layer for the agent-facing server (USE_INSIGHTS_LAYER). The object explorer never uses it."
        },
        "msSqlMcp.allowAdhocConnections": {
          "type": "boolean",
          "default": false,
          "description": "Let agents open ad-hoc connections with open_connection (MSSQL_ALLOW_ADHOC_CONNECTIONS)."
        },
        "msSqlMcp.installSkill": {
          "type": "boolean",
          "default": true,
          "description": "Install the bundled mssql-insights-ops agent skill (how agents should use this server and its AI Insights) into ~/.cursor/skills and, when Claude Code is installed, ~/.claude/skills. Updated with the extension; a copy you edited is never overwritten."
        },
        "msSqlMcp.dataViewRows": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "maximum": 10000,
          "description": "Rows Data View loads first (its TOP; the panel's TOP box changes it per view)."
        },
        "msSqlMcp.export.neutralizeFormulas": {
          "type": "boolean",
          "default": true,
          "description": "Export CSV: prefix text values that start with = + - @ (or a tab / CR) with ' so spreadsheets do not run them as formulas."
        },
        "msSqlMcp.query.maxRows": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 10000,
          "description": "Rows kept per result set when a query window runs (F5). Further rows are counted but not shown."
        },
        "msSqlMcp.intellisense.enabled": {
          "type": "boolean",
          "default": true,
          "description": "SQL IntelliSense (completion, hover, signature help) in editors bound to an open connection, from the bundled server (Microsoft SqlParser). Other SQL extensions keep their own suggestions."
        },
        "msSqlMcp.completion.enhanced": {
          "type": "boolean",
          "default": true,
          "description": "Enhanced completions in SQL editors: whole JOIN clauses and ON conditions from foreign keys, table aliases, the column picker, * expansion and quick snippets (ssf, then Tab). Also switched from the editor tab's ... menu."
        },
        "msSqlMcp.completion.tableAliases": {
          "type": "boolean",
          "default": true,
          "description": "Enhanced completions: add a generated alias (e.g. Orders o) to tables, views and functions picked after FROM or JOIN."
        },
        "msSqlMcp.completion.joinNameMatch": {
          "type": "string",
          "enum": [
            "off",
            "keyed",
            "any"
          ],
          "default": "any",
          "enumDescriptions": [
            "JOIN and ON suggestions come from foreign keys only.",
            "Also same-named columns where one side is its table's single-column primary key.",
            "Also any other same-named columns (tables without a primary key, non-key to non-key), listed after the keyed matches."
          ],
          "description": "Enhanced completions: JOIN and ON suggestions from same-named columns when no foreign key connects the tables. Generic names (Id, Name, Code, ...) never match."
        },
        "msSqlMcp.format.keywordCase": {
          "type": "string",
          "enum": [
            "lower",
            "upper",
            "preserve"
          ],
          "default": "lower",
          "description": "Format SQL (Ctrl+F2): the case of keywords, system data types and built-in functions. Identifiers, aliases and column names are never changed."
        },
        "msSqlMcp.format.formatFiles": {
          "type": "boolean",
          "default": false,
          "description": "Format Document / Format Selection (and format-on-save) also for .sql files and untitled SQL editors. Off: only the extension's query windows and object scripts; Ctrl+F2 works in every SQL editor either way."
        },
        "msSqlMcp.format.maxItemsPerRow": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 50,
          "description": "Format SQL: most columns or values per row in SELECT, INSERT, VALUES, SET, GROUP BY and ORDER BY lists."
        },
        "msSqlMcp.queryShortcuts": {
          "type": "object",
          "default": {
            "3": "select top (1000) * from {selection}"
          },
          "propertyNames": {
            "pattern": "^[0-9]$"
          },
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Query shortcuts on Ctrl+0 … Ctrl+9 in SQL editors: the key's digit maps to SQL that runs on the editor's connection (results in the Results panel; the editor text is not changed). `{selection}` is replaced by the selected text, or the name under the cursor when nothing is selected. An empty or missing slot leaves its key to VS Code. Example: `{ \"3\": \"select top (1000) * from {selection}\", \"5\": \"select * from globalVars where varName = 'dbVersion'\" }`."
        },
        "msSqlMcp.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "description": "Log verbosity. When unset: error in a normal (Production) install, debug when running in Development or Test mode."
        }
      }
    },
    "keybindings": [
      {
        "command": "msSqlMcp.runQuery",
        "key": "f5",
        "when": "editorTextFocus && msSqlMcp.editorConnected && !inDebugMode"
      },
      {
        "command": "msSqlMcp.runQuery",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == sql && resourceScheme != mssql-ddl && !msSqlMcp.editorConnected && !inDebugMode"
      },
      {
        "command": "msSqlMcp.refreshIntelliSense",
        "key": "ctrl+shift+r",
        "when": "editorTextFocus && msSqlMcp.editorConnected"
      },
      {
        "command": "msSqlMcp.filter",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView == msSqlMcp.explorer && !inputFocus"
      },
      {
        "command": "msSqlMcp.formatSql",
        "key": "ctrl+f2",
        "mac": "cmd+f2",
        "when": "editorTextFocus && editorLangId == sql && !editorReadonly"
      },
      {
        "command": "msSqlMcp.goToObjectDefinition",
        "key": "ctrl+f12",
        "mac": "cmd+f12",
        "when": "editorTextFocus && editorLangId == sql && msSqlMcp.editorConnected"
      },
      {
        "command": "msSqlMcp.queryShortcut0",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "editorTextFocus && editorLangId == sql && resourceScheme != mssql-ddl && msSqlMcp.shortcut.0"
      },
      {
        "command": "msSqlMcp.queryShortcut1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "editorTextFocus && editorLangId == sql && resourceScheme != mssql-ddl && msSqlMcp.shortcut.1"
      },
      {
        "command": "msSqlMcp.queryShortcut2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "editorTextFocus && editorLangId == sql && resourceScheme != mssql-ddl && msSqlMcp.shortcut.2"
      },
      {
        "command": "msSqlMcp.queryShortcut3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "editorTextFocus && editorLangId == sql && resourceScheme != mssql-ddl && msSqlMcp.shortcut.3"
      },
      {
        "command": "msSqlMcp.queryShortcut4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "editorTextFocus && editorLangId == sql && resourceScheme != mssql-ddl && msSqlMcp.shortcut.4"
      },
      {
        "command": "msSqlMcp.queryShortcut5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "editorTextFocus && editorLangId == sql && resourceScheme != mssql-ddl && msSqlMcp.shortcut.5"
      },
      {
        "command": "msSqlMcp.queryShortcut6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "editorTextFocus && editorLangId == sql && resourceScheme != mssql-ddl && msSqlMcp.shortcut.6"
      },
      {
        "command": "msSqlMcp.queryShortcut7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "editorTextFocus && editorLangId == sql && resourceScheme != mssql-ddl && msSqlMcp.shortcut.7"
      },
      {
        "command": "msSqlMcp.queryShortcut8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "editorTextFocus && editorLangId == sql && resourceScheme != mssql-ddl && msSqlMcp.shortcut.8"
      },
      {
        "command": "msSqlMcp.queryShortcut9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "editorTextFocus && editorLangId == sql && resourceScheme != mssql-ddl && msSqlMcp.shortcut.9"
      },
      {
        "command": "msSqlMcp.renameObject",
        "key": "f2",
        "when": "focusedView == msSqlMcp.explorer && !inputFocus"
      },
      {
        "command": "msSqlMcp.copyName",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == msSqlMcp.explorer && !inputFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile && node scripts/stage-skill.mjs",
    "test:unit": "npm run compile && node --test test/*.test.mjs",
    "check:version": "node scripts/check-version.mjs",
    "package": "vsce package --target win32-x64",
    "publish:vsce": "vsce publish --target win32-x64",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.2.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.5.0",
    "vscode-uri": "^3.2.0"
  }
}
